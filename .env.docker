# ========================================================================
# SmartOps Core Configuration
# ========================================================================

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_USER=smartops
DB_PASSWORD=smartops_dev_password
DB_NAME=smartops_core
DATABASE_URL=postgresql://smartops:smartops_dev_password@postgres:5432/smartops_core

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here

# Security
NEURALIZER_SECRET=flash

# FastAPI Configuration
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8001
FASTAPI_RELOAD=true

# n8n Configuration
N8N_USER=admin
N8N_PASSWORD=smartops_n8n_password
N8N_HOST=localhost
N8N_PORT=5678
N8N_DB_NAME=n8n

# WAHA Configuration
WAHA_MANAGER_URL=http://localhost:3000
WAHA_WEBHOOK_URL=http://localhost:3000/webhook/demo-message

# Redis Configuration (Optional)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Logging
LOG_LEVEL=INFO

# Environment
ENVIRONMENT=development
