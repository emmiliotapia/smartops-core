# SmartOps Core - Environment Variables Standard
# This file documents ALL environment variables used in the project
# IMPORTANT: This is a REFERENCE ONLY - DO NOT add actual values here
# Use .env (not tracked in git) for real credentials

# ============================================================================
# 1. API CONFIGURATION
# ============================================================================
APP_ENV=development
DEBUG=true
APP_NAME=SmartOps Core
APP_VERSION=4.0.0

# ============================================================================
# 2. SERVER CONFIGURATION
# ============================================================================
# API server binding
APP_HOST=0.0.0.0
APP_PORT=8000

# ============================================================================
# 3. POSTGRESQL DATABASE + PGVECTOR
# ============================================================================
# Connection string (required)
# Format: postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>
DATABASE_URL=

# Individual components (optional, parsed from DATABASE_URL)
DB_HOST=localhost
DB_PORT=5433
DB_USER=
DB_PASSWORD=
DB_NAME=smartops_core

# Postgres Connection pooling
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ============================================================================
# 4. OPENAI API - EMBEDDINGS & VISION
# ============================================================================
# API Key (required for RAG functionality)
OPENAI_API_KEY=

# Embedding model for RAG (1536 dimensions)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Vision model for image OCR (menu recognition)
OPENAI_VISION_MODEL=gpt-4o

# LLM model for response generation (future phase)
OPENAI_LLM_MODEL=gpt-4-turbo

# Request timeout
OPENAI_REQUEST_TIMEOUT=30

# ============================================================================
# 5. RAG (RETRIEVAL-AUGMENTED GENERATION) CONFIGURATION
# ============================================================================
# RAG category for multi-tenant support
RAG_CATEGORY=demo_comercial

# RAG index prefix for organizing vectors
RAG_INDEX_PREFIX=demo_v1

# Text chunking parameters
RAG_MAX_CHUNK_SIZE=1000

# Vector similarity threshold (0.0-1.0)
RAG_SIMILARITY_THRESHOLD=0.5

# ============================================================================
# 6. DEMO SESSION CONFIGURATION
# ============================================================================
# Session timeout in minutes
DEMO_SESSION_TIMEOUT_MINUTES=30

# Secret word for THE NEURALIZER endpoint
DEMO_NEURALIZER_SECRET=

# ============================================================================
# 7. LOGGING CONFIGURATION
# ============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/smartops.log

# ============================================================================
# 8. CORS CONFIGURATION (for frontend integration)
# ============================================================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ============================================================================
# 9. FILE STORAGE
# ============================================================================
# Directory for demo documents/menus
DEMO_FILES_PATH=./menus

# Maximum file upload size (bytes)
MAX_UPLOAD_SIZE=10485760

# ============================================================================
# 10. FEATURE FLAGS
# ============================================================================
ENABLE_VISION=true
ENABLE_RAG=true
ENABLE_LLM_RESPONSES=false

# ============================================================================
# SUMMARY - CRITICAL VARIABLES FOR SETUP
# ============================================================================
# REQUIRED (cannot run without these):
# - DATABASE_URL (or DB_HOST + DB_PORT + DB_USER + DB_PASSWORD + DB_NAME)
# - OPENAI_API_KEY
#
# IMPORTANT (core functionality):
# - DEMO_SESSION_TIMEOUT_MINUTES
# - DEMO_NEURALIZER_SECRET
#
# OPTIONAL (have sensible defaults):
# - All others
