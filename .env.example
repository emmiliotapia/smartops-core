# SmartOps Core - Environment Variables Template
# Copy this file to .env and fill in your values
# IMPORTANT: .env is NOT tracked in git - your credentials stay private

# ==================== DATABASE CONFIGURATION ====================
# PostgreSQL + pgvector connection
# Format: postgresql://user:password@host:port/database
# Example: postgresql://root:mypassword@localhost:5433/smartops_core

DATABASE_URL=

# Or use individual components (DATABASE_URL takes precedence):
DB_HOST=localhost
DB_PORT=5433
DB_USER=
DB_PASSWORD=
DB_NAME=smartops_core

# ==================== OPENAI API CONFIGURATION ====================
# Get your key from: https://platform.openai.com/api-keys
# This is REQUIRED for RAG (embeddings + vision)

OPENAI_API_KEY=

# ==================== RAG CONFIGURATION ====================
RAG_MAX_CHUNK_SIZE=1000
RAG_SIMILARITY_THRESHOLD=0.5

# ==================== DEMO SESSION CONFIGURATION ====================
DEMO_SESSION_TIMEOUT_MINUTES=30
DEMO_NEURALIZER_SECRET=

# ==================== SERVER CONFIGURATION ====================
APP_ENV=development
APP_PORT=8000

# See .env.standard for complete list of all available variables

